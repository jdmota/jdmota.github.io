{
  "private": true,
  "name": "jdmota.github.io",
  "scripts": {
    "parcel:dev": "parcel website/index.html --dist-dir=dist/dev --cache-dir .parcel-cache --no-autoinstall",
    "parcel:prod": "parcel build website/index.html --target=prod --no-cache --no-autoinstall",
    "serve": "sirv dist/prod",
    "lint": "eslint website",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\""
  },
  "browserslist": "> 0.5%, last 2 versions, not dead, not ie 11",
  "engines": {
    "node": ">=16.0.0"
  },
  "targets": {
    "prod": {
      "context": "browser",
      "distDir": "dist/prod",
      "sourceMap": false
    }
  },
  "dependencies": {
    "element-to-path": "^1.2.1",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.3",
    "svg-path-tools": "^1.0.0"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.9.1",
    "@types/node": "^20.2.5",
    "@types/papaparse": "^5",
    "@types/qrcode": "^1.5.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "parcel": "^2.9.1",
    "postcss": "^8.4.24",
    "prettier": "^2.8.8",
    "sirv-cli": "^2.0.2",
    "typescript": "^5.1.3"
  },
  "packageManager": "yarn@3.6.0"
}
