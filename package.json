{
  "private": true,
  "type": "module",
  "name": "jdmota.github.io",
  "scripts": {
    "n": "node --enable-source-maps --import @swc-node/register/esm-register",
    "i": "node --inspect-brk --enable-source-maps --import @swc-node/register/esm-register",
    "format": "prettier --write \"**/*.{js,ts,json,css,html,md,svelte}\"",
    "check": "svelte-check",
    "serve": "sirv dist --dev",
    "dev": "vite --open",
    "build": "vite build --outDir ../dist --emptyOutDir"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead, not ie 11",
  "dependencies": {
    "@sindresorhus/transliterate": "^2.3.1",
    "beercss": "^4.0.21",
    "chroma-js": "^3.2.0",
    "element-to-path": "^1.2.1",
    "match-sorter": "^8.3.0",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "svg-path-tools": "^1.0.0"
  },
  "devDependencies": {
    "@sindresorhus/slugify": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.33",
    "@tailwindcss/vite": "^4.3.0",
    "@types/chroma-js": "^3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "htmlnano": "^3.3.2",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-toc": "^1.2.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.0",
    "sirv-cli": "^3.0.1",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8",
    "svelte-language-server": "^0.18.0",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "packageManager": "yarn@4.15.0"
}
