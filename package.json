{
  "private": true,
  "type": "module",
  "name": "jdmota.github.io",
  "scripts": {
    "n": "node --enable-source-maps --import @swc-node/register/esm-register",
    "i": "node --inspect-brk --enable-source-maps --import @swc-node/register/esm-register",
    "format": "prettier --write \"**/*.{js,ts,json,css,html,md,svelte}\"",
    "check": "svelte-check",
    "serve": "sirv dist --dev",
    "dev": "vite --open",
    "build": "vite build --outDir ../dist --emptyOutDir"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead, not ie 11",
  "dependencies": {
    "@sindresorhus/transliterate": "^1.6.0",
    "element-to-path": "^1.2.1",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "svg-path-tools": "^1.0.0"
  },
  "devDependencies": {
    "@sindresorhus/slugify": "^2.2.1",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@swc-node/register": "^1.10.10",
    "@swc/core": "^1.13.3",
    "@tailwindcss/vite": "^4.1.11",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.1.0",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.5",
    "htmlnano": "^2.1.2",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-toc": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "sirv-cli": "^3.0.1",
    "svelte": "^5.37.1",
    "svelte-check": "^4.3.0",
    "svelte-language-server": "^0.17.17",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  },
  "packageManager": "yarn@4.9.2"
}
